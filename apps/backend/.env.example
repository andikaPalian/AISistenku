# Server Environment
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aisistenku-db?schema=public"

# JWT Authentication
JWT_SECRET=super_secret_jwt_access_key_min_32_characters_long_12345
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_min_32_characters_long_12345
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Google Gemini AI API
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary (Image & Asset CDN)
# Dapatkan kredensial gratis di https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
